{
  "expo": {
    "name": "FatturaAI",
    "slug": "fattura-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fattura-ai",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B5BD6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fattura-ai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Consenti l'accesso alla fotocamera per scansionare fatture"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B5BD6"
      },
      "package": "com.fatturaai.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Consenti $(PRODUCT_NAME) di accedere alla tua fotocamera per scansionare fatture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
